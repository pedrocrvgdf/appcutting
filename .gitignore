# Dependências dos testes (o app em si não tem dependência nenhuma)
node_modules/

# Cópia instrumentada do app, gerada a cada rodada de testes
.test-app.html

# Saída do Playwright
playwright-report/
test-results/
blob-report/

# Dependências das Cloud Functions
functions/node_modules/

# Saída da compilação do app Android
android/.gradle/
android/build/
android/app/build/
android/local.properties

# Chave de assinatura do APK. Ela vive em segredos do repositório, nunca aqui:
# quem tem a chave assina um APK que o Android aceita como atualização deste.
*.jks
*.keystore
